DEFINE SCHEMA

    RECORD TYPE "cloudkit.share" (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE Person (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "avatarSeed" INT64,
        "claimedByCloudUserID" STRING,
        "contactHint" STRING,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "kind" STRING,
        "modifiedAt" TIMESTAMP,
        "name" STRING,
        "schemaVersion" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Group (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "cover" ASSET,
        "coverFileName" STRING,
        "createdAt" TIMESTAMP,
        "currencyCode" STRING,
        "defaultSplit" BYTES,
        "deletedAt" TIMESTAMP,
        "isArchived" INT64,
        "kind" STRING,
        "memberIDs" BYTES,
        "modifiedAt" TIMESTAMP,
        "name" STRING,
        "pinnedRate" BYTES,
        "schemaVersion" INT64,
        "simplifiesDebts" INT64,
        "symbol" STRING,
        "tripEnd" TIMESTAMP,
        "tripStart" TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Expense (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "category" STRING,
        "createdAt" TIMESTAMP,
        "createdByID" STRING,
        "currencyCode" STRING,
        "date" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "editHistory" BYTES,
        "groupID" STRING,
        "latitude" DOUBLE,
        "locationName" STRING,
        "longitude" DOUBLE,
        "modifiedAt" TIMESTAMP,
        "note" STRING,
        "payers" BYTES,
        "receiptFileName" STRING,
        "receipt" ASSET,
        "recurrence" BYTES,
        "recurringExpenseID" STRING,
        "schemaVersion" INT64,
        "split" BYTES,
        "title" STRING,
        "totalMinorUnits" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Payment (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "amountMinorUnits" INT64,
        "createdAt" TIMESTAMP,
        "currencyCode" STRING,
        "date" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "groupID" STRING,
        "modifiedAt" TIMESTAMP,
        "note" STRING,
        "payerID" STRING,
        "receiverID" STRING,
        "schemaVersion" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Comment (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "authorID" STRING,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "editedAt" TIMESTAMP,
        "expenseID" STRING,
        "groupID" STRING,
        "modifiedAt" TIMESTAMP,
        "reactions" BYTES,
        "schemaVersion" INT64,
        "text" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Activity (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "actorID" STRING,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "event" BYTES,
        "groupID" STRING,
        "kind" STRING,
        "modifiedAt" TIMESTAMP,
        "schemaVersion" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE RecurringExpense (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "category" STRING,
        "createdAt" TIMESTAMP,
        "createdByID" STRING,
        "currencyCode" STRING,
        "deletedAt" TIMESTAMP,
        "groupID" STRING,
        "isActive" INT64,
        "lastCreatedOccurrence" TIMESTAMP,
        "modifiedAt" TIMESTAMP,
        "note" STRING,
        "payers" BYTES,
        "rule" BYTES,
        "schemaVersion" INT64,
        "split" BYTES,
        "title" STRING,
        "totalMinorUnits" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE ItemClaim (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "expenseID" STRING,
        "groupID" STRING,
        "itemIDs" BYTES,
        "modifiedAt" TIMESTAMP,
        "personID" STRING,
        "schemaVersion" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
